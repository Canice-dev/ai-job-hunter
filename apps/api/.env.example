DATABASE_URL=
WEB_ORIGIN=http://localhost:3000
OWNER_EMAIL=
# Keep the Argon2 hash wrapped in single quotes: it contains $ characters.
OWNER_PASSWORD_HASH=''
SESSION_SECRET=
# Optional. Sessions expire after 24 hours by default; allowed range is 1 to 168.
SESSION_HOURS=24
CV_STORAGE_DIR=.local-data/cvs
# NVIDIA Build's OpenAI-compatible chat completions endpoint.
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_API_KEY=
# Tavily web search for Telegram /site. Create a key at https://app.tavily.com/.
TAVILY_API_KEY=
# Create a bot with Telegram's @BotFather. Keep this token private.
TELEGRAM_BOT_TOKEN=
