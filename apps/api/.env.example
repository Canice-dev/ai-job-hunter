DATABASE_URL=
WEB_ORIGIN=http://localhost:3000
OWNER_EMAIL=
# Keep the Argon2 hash wrapped in single quotes: it contains $ characters.
OWNER_PASSWORD_HASH=''
SESSION_SECRET=
# Optional. Sessions expire after 24 hours by default; allowed range is 1 to 168.
SESSION_HOURS=24
CV_STORAGE_DIR=.local-data/cvs
# Gemini's OpenAI-compatible chat completions endpoint.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3.8-flash
AI_API_KEY=
# Create a bot with Telegram's @BotFather. Keep this token private.
TELEGRAM_BOT_TOKEN=
